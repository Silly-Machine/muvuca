{
  "name": "muvuca",
  "version": "1.0.0",
  "type": "module",
  "description": "Painel local para trabalhar com um time de agentes de IA: líder, subagentes, portão de testes e revisor.",
  "author": "Silly Machine",
  "license": "MIT",
  "homepage": "https://github.com/Silly-Machine/muvuca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silly-Machine/muvuca.git"
  },
  "bugs": {
    "url": "https://github.com/Silly-Machine/muvuca/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agentes",
    "multiagente",
    "ai-agents",
    "orquestração",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.cjs",
  "bin": {
    "muvuca": "bin/muvuca.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "config/",
    "docs/guia.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/muvuca.js",
    "servidor": "node src/servidor.js",
    "test": "node --test \"test/*.test.js\"",
    "lancar": "node scripts/versao.mjs lancar",
    "app": "electron .",
    "instalador": "electron-builder --publish never",
    "pasta-do-app": "electron-builder --dir --publish never",
    "bateria": "node scripts/bateria.mjs",
    "prepublishOnly": "node scripts/versao.mjs conferir && npm test"
  },
  "build": {
    "appId": "dev.sillymachine.muvuca",
    "productName": "Muvuca",
    "copyright": "Copyright © 2026 Silly Machine",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "electron/recursos"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/recursos/icon.png",
      "src/**",
      "public/**",
      "config/**",
      "docs/guia.md",
      "README.md",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/recursos/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Muvuca"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "electron/recursos/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "electron/recursos/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
